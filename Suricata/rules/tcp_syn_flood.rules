alert tcp any any -> $HOME_NET 80 (
    msg:"TCP SYN Flood Attack Detected"; 
    flags:S; 
    flow:stateless; 
    threshold:type both, track by_dst, count 1000, seconds 1; 
    detection_filter:track by_dst, count 5000, seconds 10; 
    metadata:policy security-ips drop; 
    sid:1000010; 
    rev:3; 
    classtype:attempted-dos; 
    reference:url,en.wikipedia.org/wiki/SYN_flood;
)