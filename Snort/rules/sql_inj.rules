alert http $EXTERNAL_NET any -> $HOME_NET 3000 (
    msg:"SQL Injection Detection"; 
    flow:to_server,established; 
    http.method; content:"POST"; 
    http.uri; content:"/rest/user/login"; nocase; 
    http.header; content:"Content-Type: application/json"; 
    http.request_body; content:"' OR 1=1--"; fast_pattern; nocase; 
    metadata:policy security-ips drop; 
    sid:1000001; 
    rev:1; 
    classtype:web-application-attack; 
    reference:cve,2019-15107; 
    reference:url,owasp.org/www-community/attacks/SQL_Injection;
    reference:url,cwe.mitre.org/data/definitions/89.html;
)