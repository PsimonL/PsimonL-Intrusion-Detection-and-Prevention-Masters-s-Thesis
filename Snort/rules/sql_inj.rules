alert http $EXTERNAL_NET any -> $HOME_NET 3000 (
    msg:"SQL Injection Detection"; 
    flow:to_server,established; 
    http_method; content:"POST"; 
    http_uri; content:"/rest/user/login"; nocase; 
    http_header; content:"Content-Type: application/json"; 
    http_request_body; content:"' OR 1=1--"; fast_pattern; nocase; 
    metadata:policy security-ips drop; 
    sid:1000004; 
    rev:1; 
    classtype:web-application-attack; 
    reference:url,owasp.org/www-community/attacks/SQL_Injection;
)