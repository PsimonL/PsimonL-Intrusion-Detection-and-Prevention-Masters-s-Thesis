alert http $EXTERNAL_NET any -> $HOME_NET 3000 (
    msg:"XSS Attack Detected"; 
    flow:to_server,established; 
    http.method; content:"PUT"; 
    http.uri; content:"/api/Products/"; nocase; 
    http.header; content:"Content-Type: application/json"; 
    http.header; content:"Authorization: Bearer"; nocase; 
    http.request_body; content:"<iframe src=\"javascript:alert"; fast_pattern; nocase; 
    metadata:policy security-ips drop; 
    sid:1000002; 
    rev:1; 
    classtype:web-application-attack; 
    reference:cve,2020-11022; 
    reference:url,owasp.org/www-community/attacks/XSS; 
    reference:url,cwe.mitre.org/data/definitions/79.html;
)