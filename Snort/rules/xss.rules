alert http $EXTERNAL_NET any -> $HOME_NET 3000 (
    msg:"XSS Attack Detected"; 
    flow:to_server,established; 
    http_method; content:"PUT"; 
    http_uri; content:"/api/Products/"; nocase; 
    http_header; content:"Content-Type: application/json"; 
    http_header; content:"Authorization: Bearer"; nocase; 
    http_request_body; content:"<iframe src="; nocase; 
    http_request_body; content:"javascript:alert"; distance:0;
    metadata:policy security-ips drop; 
    sid:1000005; 
    rev:2; 
    classtype:web-application-attack; 
    reference:url,owasp.org/www-community/attacks/XSS; 
)