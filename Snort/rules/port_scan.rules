alert tcp $EXTERNAL_NET any -> $HOME_NET any (
    msg:"Aggressive Nmap Scan Detected - Multiple Port Probes"; 
    flow:stateless; 
    flags:S; 
    detection_filter:track by_src, count 20, seconds 10; 
    metadata:policy security-ips drop; 
    sid:1000001; 
    rev:1; 
    classtype:attempted-recon; 
    reference:url,nmap.org/book/man-port-scanning-techniques.html;
)